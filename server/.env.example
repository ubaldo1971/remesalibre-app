# Environment Variables for RemesaLibre Backend

# Server Configuration
PORT=3000
NODE_ENV=development

# Local demo admin (never enable in production)
DEMO_ADMIN_ENABLED=false
DEMO_ADMIN_PHONE=+5210000000000
DEMO_ADMIN_PIN=change-me

# PayChat simulated MVP (development only; hard-disabled in production)
PAYCHAT_DEMO_ENABLED=false
PAYCHAT_CONFIRMATION_SECRET=change-me-with-a-long-random-local-secret
PAYCHAT_DEMO_MAX_AMOUNT_MINOR=100000
PAYCHAT_SIMULATOR_SCENARIO=success

# Ephemeral WhatsApp channel identities (development only)
WHATSAPP_DEMO_IDENTITIES_ENABLED=false
WHATSAPP_DEMO_IDENTITIES_JSON=[]

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=remesalibre
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# API Keys (Mock - Replace with real values)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Exchange Rate Oracle
COINGECKO_API_KEY=your_coingecko_api_key
CHAINLINK_ORACLE_ADDRESS=0x...

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Blockchain Configuration (Mock)
BLOCKCHAIN_RPC_URL=https://polygon-rpc.com
USDC_CONTRACT_ADDRESS=0x...
PESO_CONTRACT_ADDRESS=0x...
REMESA_SWAP_ADDRESS=0x...

# Security
ENCRYPTION_KEY=your-32-character-encryption-key-here
SALT_ROUNDS=10

# Mock Mode (set to true to use mock services)
MOCK_SMS=true
MOCK_BLOCKCHAIN=true
MOCK_ORACLE=true
